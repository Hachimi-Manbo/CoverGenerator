{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoverGenerator",
  "version": "1.0.0",
  "identifier": "com.covergenerator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "封面生成器 - CoverGenerator",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      }
    },
    "longDescription": "一款功能强大的封面生成器桌面应用，支持多种主题模板、图标、文字样式和背景自定义，可导出多种比例的高质量封面图片。",
    "shortDescription": "封面生成器 - 快速创建精美封面"
  }
}
